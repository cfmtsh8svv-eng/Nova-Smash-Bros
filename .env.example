# Copy to .env for local use, or set these on the host (Render dashboard, Mac mini).
# Names only: never commit real values. See docs/SETUP_SHEETS.md.
#
# Without the two SHEETS_ values the server runs with an in-memory store:
# fully playable, but accounts and scores are lost when it restarts.

# The "Web app URL" of the deployed Apps Script (ends in /exec)
SHEETS_WEBAPP_URL=
# The same long random string that is saved in the Apps Script's script properties
SHEETS_SHARED_SECRET=
# Long random string mixed into every PIN hash. Never change it once players exist.
PIN_PEPPER=
# Long random string that signs the session tokens. Changing it logs everyone out.
SESSION_SECRET=

# Optional, not secret
# PORT=3000
# HOST=127.0.0.1          (listen only on this computer, for example behind Tailscale Funnel)
# TRUST_PROXY=cloudflare  (only on Render: use the visitor address its front door reports)
