{
  "name": "nova-brawl",
  "version": "1.0.0",
  "description": "NOVA Brawl: a browser party fighter where phones are the controllers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-timeout=60000 \"tests/game/*.test.js\" \"tests/server/*.test.js\"",
    "test:browser": "node --test --test-timeout=180000 \"tests/browser/*.test.js\"",
    "test:all": "npm test && npm run test:browser"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
